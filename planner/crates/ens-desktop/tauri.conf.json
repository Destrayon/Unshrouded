{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unshrouded",
  "version": "0.1.0",
  "identifier": "com.enshroudedbuild.planner",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unshrouded — build planner and DPS meter for Enshrouded",
        "width": 1500,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": "#0D0B09",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
